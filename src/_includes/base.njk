<!doctype html>
<html lang="en-IN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{%- set pageTitle = (title + " · PondiExpress") if title and not homeTitle else (homeTitle or "PondiExpress") %}
{%- set pageDesc = description or site.defaultDescription %}
{%- set canonical = page.url | absoluteUrl(site.url) %}
{%- set ogImage = (ogImage or cover or "/images/site/social-card.jpg") | absoluteUrl(site.url) %}
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDesc }}">
<link rel="canonical" href="{{ canonical }}">
{%- if noindex %}
<meta name="robots" content="noindex">
{%- endif %}
<meta property="og:site_name" content="PondiExpress">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ pageDesc }}">
<meta property="og:url" content="{{ canonical }}">
<meta property="og:type" content="{{ 'article' if layout == 'post.njk' else 'website' }}">
<meta property="og:image" content="{{ ogImage }}">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="/favicon.ico" sizes="32x32">
<link rel="icon" href="/images/site/icon-512.png" type="image/png">
<link rel="apple-touch-icon" href="/images/site/icon-180.png">
<meta name="theme-color" content="#24343c">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Barlow:ital,wght@0,400;0,500;0,600;1,400&family=JetBrains+Mono:wght@500&display=swap">
<link rel="stylesheet" href="/css/site.css?v={{ build.version }}">
<script>document.documentElement.classList.add('js')</script>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="site-header"><div class="wrap bar">
  <a class="brand" href="/"><img src="/images/site/icon-180.png" width="40" height="40" alt=""><span class="brand-name">Pondi<span>Express</span></span></a>
  <nav class="nav" aria-label="Main">
    {%- set navItems = [["/", "Home"], ["/about/", "About"], ["/blog/", "Blog"]] %}
    {%- for item in navItems %}
    <a href="{{ item[0] }}"{% if item[0] == "/" %} class="nav-home"{% endif %}{% if page.url == item[0] or (item[0] == "/blog/" and page.url.startsWith("/blog/")) %} aria-current="page"{% endif %}>{{ item[1] }}</a>
    {%- endfor %}
    <a class="btn btn-primary" href="/sign-up/">Get started</a>
  </nav>
</div></header>

<main id="main">
{{ content | safe }}
</main>

{% if not hideBand %}
<div class="band"><div class="wrap inner">
  <div><h2>Ready to take your training to the next level?</h2><p>Sign up today, or book a free call first if you have questions.</p></div>
  <div class="ctas"><a class="btn btn-primary" href="/sign-up/">Get started</a><a class="btn btn-ghost" href="/sign-up/#call">Book a free call</a></div>
</div></div>
{% endif %}

<footer class="site-footer"><div class="wrap inner">
  <div><p class="motto">Consistency trumps talent!</p><p class="small">Coached by PondiExpress · © 2019–<span id="yr">2026</span></p></div>
  <nav class="links" aria-label="Footer">
    <a href="/about/">About</a><a href="/blog/">Blog</a><a href="/sign-up/">Get started</a><a href="/contact/">Contact</a>
    <a href="/termsofuse/">Terms, refunds and privacy</a>
    <span class="social">
      <a href="{{ site.instagram }}" rel="noopener" aria-label="PondiExpress on Instagram" title="Instagram"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none"/></svg></a>
      <a href="{{ site.strava }}" rel="noopener" aria-label="Gautam on Strava" title="Strava"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="currentColor"><path d="M15.387 17.944l-2.089-4.116h-3.065L15.387 24l5.15-10.172h-3.066m-7.008-5.599l2.836 5.598h4.172L10.463 0l-7 13.828h4.169"/></svg></a>
    </span>
  </nav>
</div></footer>
<script>document.getElementById('yr').textContent=new Date().getFullYear()</script>
</body>
</html>
